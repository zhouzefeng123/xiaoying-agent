HTTP_PORT=80

# MySQL root password. Use a long random value.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password

# Basic auth for the web UI. Use a different long random value.
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=replace-with-another-long-random-password

# Local email-code login (no Aliyun captcha).
# AUTH_ALLOWED_EMAILS is required. Multiple addresses can be comma-separated.
# Domain wildcards are supported: *@qq.com,*@vip.qq.com,*@foxmail.com
AUTH_ALLOWED_EMAILS=you@example.com

# Existing sessions without an owner are assigned to this email on startup.
LEGACY_OWNER_EMAIL=you@example.com
# Owner used by background cognitive/scheduler jobs that are not tied to a user.
SYSTEM_OWNER_EMAIL=system
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM=you@example.com
SMTP_TLS=ssl

# Uncomment these if Docker Hub is slow or unreachable.
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim
# GO_IMAGE=docker.m.daocloud.io/library/golang:1.25-bookworm
# RUNTIME_IMAGE=docker.m.daocloud.io/library/debian:bookworm-slim
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.0
